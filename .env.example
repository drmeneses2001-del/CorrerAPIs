# Puerto donde escucha el servidor
PORT=3000

# Hash bcrypt de la contraseña de acceso a la app (NO la contraseña en texto plano).
# Generarlo con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CONTRASENA', 10))"
APP_PASSWORD_HASH=

# Clave de 32 bytes en base64 usada para cifrar las API keys guardadas.
# Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Secreto para firmar la cookie de sesion (cualquier cadena larga y aleatoria)
SESSION_SECRET=

# Poner en "true" solo si sirves la app por HTTPS (recomendado en produccion,
# por ejemplo en Render)
COOKIE_SECURE=false

# Base de datos Upstash Redis (gratis, sin tarjeta) donde se guardan las
# conexiones (con las API keys ya cifradas). Sacar ambos valores del
# dashboard de tu base en https://console.upstash.com -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
